[Unit]
Description=COMP 4601A Search Engine - Assignment 1
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/student/dev/assignment1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=search-engine
Environment=NODE_ENV=production
Environment=PORT=3000

[Install]
WantedBy=multi-user.target
