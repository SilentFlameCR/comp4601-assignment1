[Unit]
Description=COMP 4601A Search Engine - Assignment 1
After=network.target

[Service]
Type=simple
User=student
WorkingDirectory=/home/student/dev/assignment1
Environment=NODE_ENV=production
Environment=PORT=3000

# Use npm start (matches your working service pattern)
ExecStart=/usr/bin/npm start

Restart=on-failure
RestartSec=2

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
